[Unit]
Description=JANR Blocklist Deployment

# Stronger network readiness dependency (replace generic network-online.target)
After=NetworkManager-wait-online.service
Wants=NetworkManager-wait-online.service

# Optional but recommended if using systemd-resolved
After=systemd-resolved.service
Wants=systemd-resolved.service

[Service]
Type=oneshot

WorkingDirectory=/opt/janr/blocklist

# Inject ThreatFox credential at runtime
LoadCredentialEncrypted=janr_threatfox:janr_threatfox

# Ensure imports work reliably
Environment=PYTHONPATH=/opt/janr/blocklist

ExecStartPre=/bin/sleep 10

ExecStart=/usr/bin/python3 /opt/janr/blocklist/janr_blocklist_deployment.py

# Hardening (kept minimal; avoid early-network side effects)
NoNewPrivileges=true
# PrivateTmp=true   # intentionally disabled for now while diagnosing network race

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
