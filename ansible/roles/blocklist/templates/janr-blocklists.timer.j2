[Unit]
Description=JANR Blocklist Update Timer

[Timer]
# Fire shortly after systemd startup (better semantics than OnBootSec)
OnStartupSec=1min

# Run periodically based on configured interval
OnUnitActiveSec={{ update_interval }}

# If system was down, run once after boot to catch up missed executions
Persistent=true

# Explicitly bind to service
Unit=janr-blocklists.service

# Optional: small jitter to avoid boot-time thundering herd
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target
