#!/usr/bin/env python3

from dataclasses import dataclass


UPDATE_INTERVAL = {{ update_interval }}


@dataclass(frozen=True)
class Asset:
    id: str
    feed: str
    dataset: str
    parser: str
    preserve_artifacts: bool


@dataclass(frozen=True)
class Blocklist:
    id: str
    name: str
    enabled: bool
    assets: list


BLOCKLISTS = [
{% for blocklist in blocklists %}
    Blocklist(
        id="{{ blocklist.id }}",
        name="{{ blocklist.name }}",
        enabled={{ 'True' if blocklist.enabled else 'False' }},

        assets=[
{% for asset in blocklist.assets %}
            Asset(
                id="{{ asset.id }}",
                feed="{{ asset.feed }}",
                dataset="{{ asset.dataset }}",
                parser="{{ asset.parser }}",
                preserve_artifacts={{ 'True' if asset.preserve_artifacts else 'False' }}
            ){% if not loop.last %},{% endif %}
{% endfor %}
        ],
    ){% if not loop.last %},{% endif %}
{% endfor %}
]
